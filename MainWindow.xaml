<Window x:Class="Quality_Vision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quality Vision"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">

    <!-- MAIN BACKGROUND -->
    <Window.Background>
        <SolidColorBrush Color="#141414"/>
    </Window.Background>

    <Grid Margin="20">

        <!-- MAIN WINDOW ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#202020"
                CornerRadius="12"
                Padding="20,0,20,0"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- LOGO -->
                <Image Grid.Column="0"
                       Source="Assets/nobia_logo.png"
                       Height="70"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Stretch="Uniform"/>


                <!-- STATION STATUS -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Station 3"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#F2F2F2"
                               HorizontalAlignment="Right"/>

                    <TextBlock x:Name="SystemStatusText"
                               Text="● System ready"
                               FontSize="14"
                               Foreground="#22C55E"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>


            <!-- CAMERA AREA -->
            <Border Grid.Column="0"
                    Background="#202020"
                    CornerRadius="12"
                    Padding="12">

                <Border Background="#0F0F0F"
                        CornerRadius="8">

                    <Image x:Name="CameraPreview"
                           Stretch="Uniform"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"/>

                </Border>

            </Border>


            <!-- RIGHT PANEL -->
            <Border Grid.Column="2"
                    Background="#202020"
                    CornerRadius="12"
                    Padding="25">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- CAMERA -->
                        <RowDefinition Height="Auto"/>

                        <!-- MARKERS -->
                        <RowDefinition Height="Auto"/>

                        <!-- MEASUREMENTS -->
                        <RowDefinition Height="Auto"/>

                        <!-- MEASUREMENT VIEW -->
                        <RowDefinition Height="*"/>

                        <!-- LAST MES CALL -->
                        <RowDefinition Height="Auto"/>

                        <!-- BUTTON -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- CAMERA STATUS -->
                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,20">

                        <TextBlock Text="Camera"
                                   FontSize="14"
                                   Foreground="#A3A3A3"/>

                        <TextBlock x:Name="CameraStatusText"
                                   Text="● Connected"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#22C55E"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- REFERENCE MARKERS -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,20">

                        <TextBlock Text="Reference markers"
                                   FontSize="14"
                                   Foreground="#A3A3A3"/>

                        <TextBlock x:Name="MarkerStatusText"
                                   Text="0 / 4"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#D71213"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- MEASUREMENT RESULTS -->
                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,15">

                        <TextBlock Text="Measurement"
                                   FontSize="14"
                                   Foreground="#A3A3A3"
                                   Margin="0,0,0,10"/>


                        <!-- X RESULT -->
                        <Border Background="#292929"
                                CornerRadius="8"
                                Padding="14"
                                Margin="0,0,0,10">

                            <StackPanel>

                                <TextBlock Text="X"
                                           FontSize="13"
                                           Foreground="#A3A3A3"/>

                                <TextBlock x:Name="XMeasurementText"
                                           Text="--- mm"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#F2F2F2"/>

                            </StackPanel>

                        </Border>


                        <!-- Y RESULT -->
                        <Border Background="#292929"
                                CornerRadius="8"
                                Padding="14">

                            <StackPanel>

                                <TextBlock Text="Y"
                                           FontSize="13"
                                           Foreground="#A3A3A3"/>

                                <TextBlock x:Name="YMeasurementText"
                                           Text="--- mm"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#F2F2F2"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>


                    <!-- MEASUREMENT VIEW -->
                    <Border Grid.Row="3"
                            Background="#292929"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,15">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                       Text="Measurement view"
                                       FontSize="13"
                                       Foreground="#A3A3A3"
                                       Margin="0,0,0,8"/>


                            <Border Grid.Row="1"
                                    Background="#0F0F0F"
                                    CornerRadius="6"
                                    MinHeight="120">

                                <Image x:Name="RectifiedPreview"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"/>

                            </Border>

                        </Grid>

                    </Border>


                    <!-- LAST MES CALL -->
                    <Border Grid.Row="4"
                            Background="#292929"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,0,15">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Last MES call"
                                           FontSize="13"
                                           Foreground="#A3A3A3"/>

                                <TextBlock Text="● 200 OK"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#22C55E"
                                           Margin="0,4,0,0"/>

                            </StackPanel>


                            <TextBlock Grid.Column="1"
                                       Text="18:23:14"
                                       FontSize="13"
                                       Foreground="#808080"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- MANUAL MEASURE BUTTON -->
                    <Button Grid.Row="5"
                            Content="MEASURE"
                            Height="65"
                            FontSize="20"
                            FontWeight="Bold"
                            Background="#22C55E"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">

                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                </Grid>

            </Border>

        </Grid>


        <!-- FOOTER -->
        <Grid Grid.Row="2"
              Margin="5,10,5,0">

            <TextBlock Text="Quality Vision System"
                       VerticalAlignment="Center"
                       Foreground="#808080"/>

            <TextBlock Text="Version 0.1.0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#808080"/>

        </Grid>

    </Grid>

</Window>